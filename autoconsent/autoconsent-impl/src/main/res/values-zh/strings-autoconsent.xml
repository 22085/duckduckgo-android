<resources xmlns:tools="http://schemas.android.com/tools">
    <string name="autoconsentTitle">Cookie 弹窗防护</string>
    <string name="autoconsentDescription"><![CDATA[DuckDuckGo 会尽量为您选择最注重隐私的设置，并为您隐藏这些弹窗。\n<a href="">了解详情</a>]]></string>
    <string name="autoconsentToggle">让 DuckDuckGo 处理 Cookie 弹窗</string>
