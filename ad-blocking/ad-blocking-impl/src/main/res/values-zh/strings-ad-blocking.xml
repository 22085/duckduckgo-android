<resources>
    <string name="ad_blocking_settings_title">YouTube 广告拦截</string>
    <string name="ad_blocking_settings_toggle_title">拦截 YouTube 广告</string>
    <string name="ad_blocking_settings_description_with_consent">DuckDuckGo 会拦截 YouTube 上的视频广告，让您不间断地观看视频。\n\n开启后，DuckDuckGo 会匿名检测广告拦截干扰或 YouTube 错误，以改善所有人的体验。DuckDuckGo 不会看到您观看了哪些视频，也不会看到任何个人身份信息。<annotation type="learn_more_link">了解详情</annotation></string>
    <string name="ad_blocking_settings_description">DuckDuckGo 会拦截 YouTube 上的视频广告，让您不间断地观看视频。<annotation type="learn_more_link">了解详情</annotation></string>
    <string name="ad_blocking_settings_duck_player_header">Duck Player</string>
    <string name="ad_blocking_settings_duck_player_description">以无干扰的影院模式打开视频，防止您观看的内容影响 YouTube 推荐。</string>
    <string name="ad_blocking_settings_duck_player_link">想找 Duck Player？</string>
