<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/keyline_4">

        <com.duckduckgo.common.ui.view.text.DaxTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/googleAdsTestTitle"
            app:typography="h2" />

        <com.duckduckgo.common.ui.view.text.DaxTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/keyline_1"
            android:text="@string/googleAdsTestDescription"
            app:typography="body1" />

        <com.duckduckgo.common.ui.view.text.DaxTextView
            android:id="@+id/googleAdsTestStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/keyline_4"
            android:text="@string/googleAdsTestStatusIdle"
            app:textType="secondary"
            app:typography="body1" />

        <com.duckduckgo.common.ui.view.button.DaxButtonSecondary
            android:id="@+id/googleAdsTestShowBannerButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/keyline_4"
            android:text="@string/googleAdsTestShowBanner" />

        <FrameLayout
            android:id="@+id/googleAdsTestBannerContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/keyline_1" />

        <com.duckduckgo.common.ui.view.button.DaxButtonSecondary
            android:id="@+id/googleAdsTestShowInterstitialButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/keyline_4"
            android:text="@string/googleAdsTestShowInterstitial" />

        <com.duckduckgo.common.ui.view.button.DaxButtonSecondary
            android:id="@+id/googleAdsTestShowRewardedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/keyline_1"
            android:text="@string/googleAdsTestShowRewarded" />

        <com.duckduckgo.common.ui.view.button.DaxButtonSecondary
            android:id="@+id/googleAdsTestShowRewardedInterstitialButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/keyline_1"
            android:text="@string/googleAdsTestShowRewardedInterstitial" />

        <com.duckduckgo.common.ui.view.button.DaxButtonSecondary
            android:id="@+id/googleAdsTestShowNativeButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/keyline_1"
            android:text="@string/googleAdsTestShowNative" />

        <com.google.android.gms.ads.nativead.NativeAdView
            android:id="@+id/googleAdsTestNativeAdView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/keyline_1"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/googleAdsTestNativeIcon"
                    android:layout_width="48dp"
                    android:layout_height="48dp" />

                <com.duckduckgo.common.ui.view.text.DaxTextView
                    android:id="@+id/googleAdsTestNativeHeadline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:typography="body1_bold" />

                <com.duckduckgo.common.ui.view.text.DaxTextView
                    android:id="@+id/googleAdsTestNativeBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:typography="body1" />

                <com.google.android.gms.ads.nativead.MediaView
                    android:id="@+id/googleAdsTestNativeMedia"
                    android:layout_width="match_parent"
                    android:layout_height="180dp" />

                <com.duckduckgo.common.ui.view.text.DaxTextView
                    android:id="@+id/googleAdsTestNativeCallToAction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:typography="button" />

            </LinearLayout>

        </com.google.android.gms.ads.nativead.NativeAdView>

        <com.duckduckgo.common.ui.view.button.DaxButtonSecondary
            android:id="@+id/googleAdsTestShowAppOpenButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/keyline_1"
            android:text="@string/googleAdsTestShowAppOpen" />

    </LinearLayout>

</ScrollView>
